PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Solo para crear el primer administrador en una base vacía:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Para despliegue, configura NODE_ENV=production en el proceso del servidor.
MAX_UPLOAD_MB=250
# Producción detrás de UN proxy de confianza: TRUST_PROXY=1
TRUST_PROXY=0
